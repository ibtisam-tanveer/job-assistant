MONGODB_URI=mongodb://localhost:27017/jobassistant
OPENAI_API_KEY=
# Optional; default is gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
INGEST_SECRET=jobassistant-local-dev-ingest

# Optional. When set, browser/UI must send Authorization: Bearer <same> on /jobs/* (see apps/web JOB_API_SECRET).
WEB_API_SECRET=

# Optional. Comma-separated extra origins for CORS (localhost is always allowed).
CORS_EXTRA_ORIGINS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:3000/?google=connected
